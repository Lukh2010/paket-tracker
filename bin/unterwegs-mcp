#!/usr/bin/env python3
"""
unterwegs-mcp: Model Context Protocol (MCP) Server for the Unterwegs AliExpress Package Tracker.
Allows AI assistants (Antigravity, Claude Desktop, Cursor, ChatGPT, etc.) to query package statuses,
track shipments, add/remove packages, and refresh tracking data in the background.
"""

import asyncio
import json
import os
import re
import sys
import urllib.parse
import urllib.request
from typing import Any, Dict, List, Optional
from mcp.server.mcpserver import MCPServer

SERVER_BASE_URLS = [
    "http://[::1]:4317",
    "http://127.0.0.1:4317",
    "http://localhost:4317",
]

DATA_DIR = os.path.expanduser("~/.local/share/unterwegs")
DATA_FILE = os.path.join(DATA_DIR, "parcels.json")

server = MCPServer("unterwegs-aliexpress-tracker")


def _http_request(endpoint: str, method: str = "GET", data: Optional[Dict[str, Any]] = None) -> Optional[Any]:
    """Helper to request the local tracker server."""
    payload = json.dumps(data).encode("utf-8") if data is not None else None
    headers = {"Accept": "application/json"}
    if payload:
        headers["Content-Type"] = "application/json"

    for base in SERVER_BASE_URLS:
        url = f"{base}{endpoint}"
        try:
            req = urllib.request.Request(url, data=payload, headers=headers, method=method)
            with urllib.request.urlopen(req, timeout=10) as resp:
                if 200 <= resp.status < 300:
                    return json.loads(resp.read().decode("utf-8"))
        except Exception:
            continue
    return None


def _load_local_store() -> List[Dict[str, Any]]:
    """Fallback: read parcels from persistent local JSON file."""
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return [
        {"number": "00340435069718576091", "name": "G3 Max · Hinterradmotor", "note": "850 W · AliExpress"},
        {"number": "00340435069718399393", "name": "Motorrad-Lenkerteil · 22 mm", "note": "AliExpress"},
        {"number": "AP00844166750486", "name": "Gashebel & Kleinteile", "note": "2 × WUXING"},
        {"number": "00340435069718665368", "name": "Motorrad-Lenkerteil · 22 mm", "note": "AliExpress"},
    ]


def _save_local_store(parcels: List[Dict[str, Any]]):
    """Fallback: write parcels to persistent local JSON file."""
    os.makedirs(DATA_DIR, exist_ok=True)
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(parcels, f, ensure_ascii=False, indent=2)


def _fetch_cainiao_direct(number: str) -> Dict[str, Any]:
    """Fallback: fetch Cainiao tracking directly."""
    clean = re.sub(r"\s+", "", number).upper()
    url = f"https://global.cainiao.com/global/detail.json?mailNos={urllib.parse.quote(clean)}&lang=en-US"
    req = urllib.request.Request(
        url,
        headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        raw = json.loads(resp.read().decode("utf-8"))
    
    if not raw.get("success") or not raw.get("module"):
        raise RuntimeError("No tracking data found on Cainiao for this number.")
    
    item = raw["module"][0]
    events = [
        {"time": e.get("time"), "description": e.get("standerdDesc") or e.get("desc"), "code": e.get("actionCode")}
        for e in item.get("detailList", [])
    ]
    return {
        "number": clean,
        "internationalNumber": item.get("copyRealMailNo"),
        "origin": item.get("originCountry"),
        "destination": item.get("destCountry"),
        "status": item.get("status"),
        "carrier": (item.get("destCpInfo") or {}).get("cpName", "Cainiao"),
        "events": events,
    }


@server.tool(
    name="get_package_summary",
    description="Liefert eine sofort lesbare Übersicht aller Pakete (wie viele unterwegs / angekommen sind, und aktueller Status jedes Pakets). Perfekt zur direkten Beantwortung von Nutzerfragen wie 'Wo sind meine Pakete?'."
)
def get_package_summary() -> str:
    """Returns markdown summary of all tracked packages."""
    res = _http_request("/api/ai/summary")
    if res and res.get("markdownSummary"):
        return res["markdownSummary"]

    # Fallback to local store
    parcels = _load_local_store()
    return f"📦 **AliExpress / Cainiao Paketübersicht (Lokal)**\nGesamt: {len(parcels)} Pakete hinterlegt.\n" + "\n".join(
        [f"- **{p['name']}** (`{p['number']}`): {p.get('note', '')}" for p in parcels]
    )


@server.tool(
    name="list_packages",
    description="Gibt alle aktuell überwachten Sendungen mit Sendungsnummer, Name, Status, letztem Ereignis und Transporteur als strukturierte Daten zurück."
)
def list_packages() -> str:
    """Returns structured JSON list of all tracked packages."""
    res = _http_request("/api/ai/parcels")
    if res and "parcels" in res:
        return json.dumps(res, ensure_ascii=False, indent=2)

    parcels = _load_local_store()
    return json.dumps({"totalCount": len(parcels), "parcels": parcels}, ensure_ascii=False, indent=2)


@server.tool(
    name="get_package_details",
    description="Ruft die vollständige Tracking-Historie (alle Zwischenstationen und Zeitstempel) für eine bestimmte Sendungsnummer ab."
)
def get_package_details(tracking_number: str) -> str:
    """Returns detailed history for one tracking number."""
    clean = re.sub(r"\s+", "", tracking_number).upper()
    res = _http_request(f"/api/track?number={urllib.parse.quote(clean)}")
    if res:
        return json.dumps(res, ensure_ascii=False, indent=2)

    try:
        data = _fetch_cainiao_direct(clean)
        return json.dumps(data, ensure_ascii=False, indent=2)
    except Exception as e:
        return json.dumps({"error": f"Sendungsverlauf konnte nicht abgerufen werden: {str(e)}"}, ensure_ascii=False)


@server.tool(
    name="add_package",
    description="Fügt eine neue Sendungsnummer zur Überwachung hinzu. Ruft sofort die aktuellen Trackingdaten ab."
)
def add_package(tracking_number: str, name: str, note: str = "") -> str:
    """Adds a new package to track."""
    clean = re.sub(r"\s+", "", tracking_number).upper()
    res = _http_request("/api/ai/parcels", method="POST", data={
        "number": clean,
        "name": name,
        "note": note or "Über KI hinzugefügt",
    })
    if res:
        return json.dumps(res, ensure_ascii=False, indent=2)

    # Local store fallback
    parcels = _load_local_store()
    if any(p["number"] == clean for p in parcels):
        return json.dumps({"message": f"Paket {clean} ist bereits in der Liste vorhanden."}, ensure_ascii=False)

    new_p = {"number": clean, "name": name, "note": note}
    try:
        new_p["data"] = _fetch_cainiao_direct(clean)
    except Exception:
        pass
    parcels.append(new_p)
    _save_local_store(parcels)
    return json.dumps({"success": True, "message": f"Paket '{name}' ({clean}) lokal hinzugefügt.", "parcel": new_p}, ensure_ascii=False, indent=2)


@server.tool(
    name="remove_package",
    description="Entfernt ein Paket anhand seiner Sendungsnummer aus dem Tracker."
)
def remove_package(tracking_number: str) -> str:
    """Removes a package from tracking."""
    clean = re.sub(r"\s+", "", tracking_number).upper()
    res = _http_request(f"/api/ai/parcels?number={urllib.parse.quote(clean)}", method="DELETE")
    if res:
        return json.dumps(res, ensure_ascii=False, indent=2)

    parcels = _load_local_store()
    new_list = [p for p in parcels if p["number"] != clean]
    if len(new_list) == len(parcels):
        return json.dumps({"error": f"Paket {clean} wurde nicht gefunden."}, ensure_ascii=False)

    _save_local_store(new_list)
    return json.dumps({"success": True, "message": f"Paket {clean} gelöscht."}, ensure_ascii=False)


@server.tool(
    name="refresh_packages",
    description="Aktualisiert alle Sendungsdaten live von Cainiao."
)
def refresh_packages(tracking_number: str = "") -> str:
    """Forces a refresh of all tracked packages from Cainiao."""
    clean = re.sub(r"\s+", "", tracking_number).upper() if tracking_number else None
    res = _http_request("/api/parcels/refresh", method="POST", data={"number": clean} if clean else {})
    if res:
        return json.dumps(res, ensure_ascii=False, indent=2)

    # Fallback
    parcels = _load_local_store()
    updated = 0
    for p in parcels:
        if clean and p["number"] != clean:
            continue
        try:
            p["data"] = _fetch_cainiao_direct(p["number"])
            updated += 1
        except Exception:
            pass
    _save_local_store(parcels)
    return json.dumps({"success": True, "updated": updated, "message": f"{updated} Pakete aktualisiert."}, ensure_ascii=False)


@server.tool(
    name="track_single_number",
    description="Fragt eine beliebige Sendungsnummer ad-hoc bei Cainiao ab, ohne sie im Tracker zu speichern."
)
def track_single_number(tracking_number: str) -> str:
    """Direct lookup for any tracking number without saving."""
    clean = re.sub(r"\s+", "", tracking_number).upper()
    res = _http_request(f"/api/track?number={urllib.parse.quote(clean)}")
    if res:
        return json.dumps(res, ensure_ascii=False, indent=2)

    try:
        data = _fetch_cainiao_direct(clean)
        return json.dumps(data, ensure_ascii=False, indent=2)
    except Exception as e:
        return json.dumps({"error": f"Tracking fehlgeschlagen: {str(e)}"}, ensure_ascii=False)


if __name__ == "__main__":
    asyncio.run(server.run_stdio_async())
